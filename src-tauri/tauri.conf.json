{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kairo",
  "version": "0.1.3",
  "identifier": "io.github.rudra78996.kairo",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "Kairo",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "create": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' asset: https://i.ytimg.com data: blob:; media-src 'self' asset: blob:; frame-src https://www.youtube-nocookie.com; connect-src 'self' ipc: http://ipc.localhost https://www.youtube.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Productivity",
    "shortDescription": "A calm, local-first focus timer and study tracker.",
    "longDescription": "Kairo combines open-ended focus sessions, customizable Pomodoro cycles, study history, insights, and distraction-free YouTube playback in a private local-first desktop app.",
    "licenseFile": "../LICENSE",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "recommends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav",
          "gstreamer1.0-pulseaudio"
        ],
        "desktopTemplate": "desktop/kairo.desktop.hbs",
        "postInstallScript": "desktop/postinstall.sh",
        "postRemoveScript": "desktop/postremove.sh",
        "files": {
          "/usr/share/metainfo/io.github.rudra78996.kairo.metainfo.xml": "desktop/io.github.rudra78996.kairo.metainfo.xml",
          "/usr/share/applications/io.github.rudra78996.kairo.desktop": "desktop/io.github.rudra78996.kairo.desktop",
          "/usr/share/icons/hicolor/32x32/apps/io.github.rudra78996.kairo.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/64x64/apps/io.github.rudra78996.kairo.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/io.github.rudra78996.kairo.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/io.github.rudra78996.kairo.png": "icons/128x128@2x.png",
          "/usr/share/icons/hicolor/512x512/apps/io.github.rudra78996.kairo.png": "icons/icon.png"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
